APP_NAME=MolMeDB
APP_ENV=local
APP_KEY= 
APP_DEBUG=true 
APP_TIMEZONE=Europe/Prague

APP_URL=http://localhost:9080
APP_ADMIN_URL="${APP_URL}"
ASSET_URL="${APP_URL}"

# Production: the admin domain (e.g. https://admin.molmedb.upol.cz), which serves /depict/.
CDK_DEPICT_URL=http://cdkdepict:8080         # public URL used in image URLs served to browser
CDK_DEPICT_INTERNAL_URL=http://cdkdepict:8080 # internal Docker URL for health check (ping /test)
RDKIT_HOST=rdkit

TURNSTILE_ENABLED=true
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=3x00000000000000000000FF

#############################
#### PRODUCTION ROUTING ####
#############################
# Domains routed by the production nginx (docker-compose-production.yaml),
# see docker/production/nginx/README.md.
MOLMEDB_SITE_HOST=molmedb.upol.cz
MOLMEDB_ADMIN_HOST=admin.molmedb.upol.cz
MOLMEDB_RDF_HOST=rdf.molmedb.upol.cz

###########################
#### FRONTEND SETTINGS ####
###########################
FRONTEND_URL=http://frontend:3000 # Change to real domain
NODE_ENV=develop
NEXT_PUBLIC_BACKEND_URL="${APP_URL}"
JWT_SECRET="${APP_KEY}"

COOKIES_BACKEND_XSRF_KEY=XSRF-TOKEN
COOKIES_BACKEND_SESSION_KEY=molmedb_session
COOKIES_FRONTEND_SESSION_KEY=molmedb_fe_session
COOKIES_FRONTEND_SESSION_USER_KEY=molmedb_fe_session_user
###########################

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=molmedb
DB_USERNAME=postgres
DB_PASSWORD=admin123456

DB_PREDICTIONS_CONNECTION=predictions
DB_PREDICTIONS_HOST=predictions
DB_PREDICTIONS_PORT=5432
DB_PREDICTIONS_DATABASE=molmedb_predictions
DB_PREDICTIONS_USERNAME=postgres
DB_PREDICTIONS_PASSWORD=admin123456

#############################
#### REMOTE PREDICTION SERVICE ####
#############################
# ENABLED and URL are configured in the DB config table (remote_prediction:enabled, remote_prediction:url)
# TOKEN is auto-managed (stored in DB config table, refreshed via MANAGER_SECRET when expired)
REMOTE_PREDICTION_MANAGER_SECRET=
REMOTE_PREDICTION_SEND_METHOD_PARAMETER=false
REMOTE_PREDICTION_CONNECT_TIMEOUT=5
REMOTE_PREDICTION_TIMEOUT=60
REMOTE_PREDICTION_DOWNLOAD_TIMEOUT=300
REMOTE_PREDICTION_STATUS_INTERVAL_SECONDS=300
REMOTE_PREDICTION_MAX_ACTIVE=100
REMOTE_PREDICTION_MAX_STATUS_REQUESTS_PER_MINUTE=30
REMOTE_PREDICTION_MAX_RESULT_DOWNLOADS=5
REMOTE_PREDICTION_MAX_SUBMISSIONS=5
REMOTE_PREDICTION_EVENTS_LIMIT=100
PREDICTION_RESULT_IMPORT_BATCH_SIZE=50

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="molmedb@upol.cz"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Generate with: php artisan webpush:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:molmedb@upol.cz"

VITE_APP_NAME="${APP_NAME}"
