{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "codewithdennis/filament-select-tree": "^4.0",
        "filament/filament": "^5.0",
        "laravel/fortify": "^1.25",
        "laravel/framework": "^13.0",
        "laravel/mcp": "^0.6.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "league/flysystem-path-prefixing": "^3.0",
        "league/flysystem-sftp-v3": "^3.0",
        "livewire/livewire": "^4.0",
        "minishlink/web-push": "^11.0",
        "predis/predis": "^2.0",
        "pxlrbt/filament-activity-log": "^2.0",
        "solution-forest/filament-tree": "^4.0",
        "spatie/laravel-activitylog": "^4.12",
        "spatie/laravel-backup": "^10.2",
        "spatie/laravel-permission": "^7.3",
        "symfony/filesystem": "^7.2",
        "tucker-eric/eloquentfilter": "^3.6"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "filament/upgrade": "^5.0",
        "laravel/boost": "^2.4",
        "laravel/breeze": "^2.4",
        "laravel/pail": "^1.1",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "pestphp/pest": "^4.4",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "modules/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve --host=127.0.0.1\" \"php artisan queue:work --queue=upload,default --sleep=3 --timeout=1800 --tries=3 --memory=512\" \"php artisan pail --timeout=0\" \"npm run dev -- --host 127.0.0.1\" --names=server,queue,logs,vite"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "providers": [
            "modules\\PredictionWorkers\\PredictionWorkerServiceProvider"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
